# OpenAI API 키 (필수)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1

AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=2048

# 멀티에이전트 운영 가드레일
MAX_COST_USD=0.50          # 실행 1회당 비용 상한
MAX_TOTAL_TOKENS=200000    # 실행 1회당 총 토큰 상한
AGENT_TIMEOUT_SEC=60       # 에이전트 1회 호출 타임아웃
MAX_RETRIES=2              # 일시 오류 재시도 횟수
MAX_REVIEW_ROUNDS=2        # reviewer↔writer 수정 루프 상한
REVIEW_PASS_SCORE=0.7      # 이 점수 이상이면 통과
ALLOW_WRITE_TOOLS=false    # write 도구(save_report) 허용 여부

# 지식베이스/리포트 경로
KNOWLEDGE_DIR=./data/knowledge
REPORTS_DIR=./reports
