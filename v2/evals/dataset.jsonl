{"id": "q01", "question": "입사 2년 차인데 연차가 며칠 나와?", "expected_answer": "1년 이상 3년 미만은 연 11일", "expected_source": "vacation_policy.md"}
{"id": "q02", "question": "오전 반차를 쓰면 연차 며칠이 차감돼?", "expected_answer": "반차는 연차 0.5일 차감", "expected_source": "vacation_policy.md"}
{"id": "q03", "question": "쓰지 않은 연차는 언제까지 이월할 수 있어?", "expected_answer": "다음 해 3월 31일까지", "expected_source": "vacation_policy.md"}
{"id": "q04", "question": "가족 돌봄 때문에 쉬어야 하는데 유급이야?", "expected_answer": "가족돌봄휴가는 연 10일 범위에서 유급", "expected_source": "vacation_policy.md"}
{"id": "q05", "question": "주 3일 재택근무 가능한가?", "expected_answer": "주 2회까지 가능, 팀 리더 승인 필요", "expected_source": "vacation_policy.md"}
{"id": "q06", "question": "우리 Git 브랜치 전략이 뭐야?", "expected_answer": "GitHub Flow — main/feature/hotfix 브랜치", "expected_source": "dev_environment.md"}
{"id": "q07", "question": "커밋 메시지 규칙이 있나요?", "expected_answer": "Conventional Commits — feat/fix/docs 등 접두사", "expected_source": "dev_environment.md"}
{"id": "q08", "question": "실시간 소통은 어떤 도구를 써?", "expected_answer": "Slack — #general, #dev, #random 채널", "expected_source": "dev_environment.md"}
{"id": "q09", "question": "로컬 개발환경을 어떻게 띄워?", "expected_answer": "docker compose up -d + pnpm install + pnpm dev", "expected_source": "dev_environment.md"}
{"id": "q10", "question": "PR 머지에 필요한 조건이 뭐야?", "expected_answer": "최소 1명 승인 + CI 통과", "expected_source": "dev_environment.md"}
{"id": "q11", "question": "비밀번호 최소 길이가 어떻게 돼?", "expected_answer": "12자 이상, 대소문자+숫자+특수문자", "expected_source": "security_policy.md"}
