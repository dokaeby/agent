{"id": "q13", "question": "데이터 분류 단계가 어떻게 돼?", "expected_answer": "공개/내부/기밀 3단계", "expected_source": "security_policy.md"}
{"id": "q14", "question": "AWS S3 버킷 보안 설정은?", "expected_answer": "퍼블릭 접근 차단 + CloudTrail 로깅 활성화", "expected_source": "security_policy.md"}
